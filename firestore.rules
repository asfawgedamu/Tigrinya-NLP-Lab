rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidComment(data) {
      return data.keys().hasAll(['author', 'category', 'text', 'timestamp', 'upvotes'])
        && data.keys().hasOnly(['author', 'affiliation', 'category', 'text', 'timestamp', 'upvotes', 'replies'])
        && data.author is string && data.author.size() > 0 && data.author.size() <= 100
        && (!data.keys().has('affiliation') || (data.affiliation is string && data.affiliation.size() <= 150))
        && data.category is string && data.category in ['General Feedback', 'Dialect Inquiry', 'Research Discussion', 'Feature Request']
        && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
        && data.timestamp is string
        && data.upvotes is int
        && (!data.keys().has('replies') || data.replies is list);
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['text', 'predicted', 'correct', 'status', 'timestamp'])
        && data.keys().hasOnly(['text', 'predicted', 'errorType', 'correct', 'notes', 'timestamp', 'status', 'moderatorComment'])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
        && data.predicted is string
        && (!data.keys().has('errorType') || data.errorType is string)
        && data.correct is string
        && (!data.keys().has('notes') || (data.notes is string && data.notes.size() <= 1000))
        && data.timestamp is string
        && data.status is string && data.status in ['Pending Validation', 'Approved', 'Rejected']
        && (!data.keys().has('moderatorComment') || data.moderatorComment is string);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isValidId(commentId) && isValidComment(request.resource.data);
      allow update: if isValidId(commentId) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes']) && request.resource.data.upvotes == resource.data.upvotes + 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies']) && request.resource.data.replies is list) ||
        isValidComment(request.resource.data)
      );
      allow delete: if false;
    }

    match /feedbackSubmissions/{submissionId} {
      allow read: if true;
      allow create: if isValidId(submissionId) && isValidFeedback(request.resource.data);
      allow update: if isValidId(submissionId) && isValidFeedback(request.resource.data);
      allow delete: if false;
    }
  }
}
